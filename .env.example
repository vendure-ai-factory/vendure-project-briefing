# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# LLM Budget Configuration
# LLM_BUDGET_TOTAL_USD - total LLM budget in USD (default: 20.00)
# LLM_BUDGET_WARNING_THRESHOLD - warning threshold as fraction (default: 0.80)
LLM_BUDGET_TOTAL_USD=
LLM_BUDGET_WARNING_THRESHOLD=

# Pipeline Configuration
PIPELINE_WORKSPACE_ROOT=
PIPELINE_LOG_LEVEL=info
